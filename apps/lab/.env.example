# Google Map Tiles API server key (same variable as MetaHackathon).
# Copy this line into .env.local and restart npm run dev.
GOOGLE_MAPS_API_KEY=

# Meta Model API key for explicit SAM 3.1 image runs.
MODEL_API_KEY=

# Public browser configuration for Earth Engine OAuth (not client secrets).
VITE_EARTH_ENGINE_PROJECT_ID=
VITE_EARTH_ENGINE_CLIENT_ID=

# Optional: a Photon-compatible geocoder endpoint (default public demo server).
# PHOTON_GEOCODER_URL=https://photon.komoot.io/api/
