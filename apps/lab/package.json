{
  "name": "geoscience-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "preview": "vite preview --port 5173",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "paperrun:setup": "uv venv paperruns/.venv --allow-existing && uv pip install --python paperruns/.venv/bin/python numpy scipy matplotlib pandas",
    "paperrun:mcp": "node --experimental-strip-types server/paperrunMcp.ts"
  },
  "dependencies": {
    "@meta-sam/parser": "^0.1.0",
    "d3-contour": "^4.0.2",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.16.0",
    "pngjs": "^7.0.0",
    "polygon-clipping": "^0.15.7",
    "proj4": "^2.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/react": "^16.3.3",
    "@types/d3-contour": "^3.0.6",
    "@types/node": "^26.6.6",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^28.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
